<!DOCTYPE html>

<html>

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>FAQ Admin Panel</title>

    <link rel="stylesheet"
          href="{{ url_for('static',
          filename='style.css') }}">

</head>

<body>

<div class="admin-container">

    <h1>FAQ Admin Panel</h1>


    {% if message %}

    <div class="success">

        {{ message }}

    </div>

    {% endif %}


    <form method="POST">

        <label>Question</label>

        <input
            type="text"
            name="question"
            placeholder="Enter FAQ question"
            required
        >


        <label>Answer</label>

        <textarea
            name="answer"
            placeholder="Enter FAQ answer"
            required
        ></textarea>


        <label>Category</label>

        <input
            type="text"
            name="category"
            placeholder="Example: AI"
        >


        <button type="submit">
            Add FAQ
        </button>

    </form>


    <h2>Existing FAQs</h2>


    <table>

        <tr>

            <th>ID</th>

            <th>Question</th>

            <th>Answer</th>

            <th>Category</th>

            <th>Action</th>

        </tr>


        {% for faq in faqs %}

        <tr>

            <td>
                {{ faq["id"] }}
            </td>

            <td>
                {{ faq["question"] }}
            </td>

            <td>
                {{ faq["answer"] }}
            </td>

            <td>
                {{ faq["category"] }}
            </td>

            <td>

                <a
                    href="{{ url_for('delete_faq',
                    faq_id=faq['id']) }}"
                    onclick="return confirm('Delete this FAQ?')"
                >
                    Delete
                </a>

            </td>

        </tr>

        {% endfor %}

    </table>


    <br>

    <a href="{{ url_for('home') }}">
        ← Back to Assistant
    </a>

</div>

</body>

</html>
