<!DOCTYPE html>

<html>

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>AI FAQ Assistant</title>

    <link rel="stylesheet"
          href="{{ url_for('static',
          filename='style.css') }}">

</head>

<body>

    <div class="main-container">

        <div class="header">

            <h1>🤖 AI FAQ Assistant</h1>

            <p>
                Ask your question and get an instant answer
            </p>

        </div>


        <div class="chat-box">

            <form method="POST">

                <input
                    type="text"
                    name="question"
                    value="{{ question }}"
                    placeholder="Type your question..."
                    autocomplete="off"
                    required
                >

                <button type="submit">
                    Ask
                </button>

            </form>


            {% if answer %}

            <div class="answer-box">

                <h2>Answer</h2>

                <p>{{ answer }}</p>

            </div>

            {% endif %}

        </div>


        <div class="examples">

            <h3>Example Questions</h3>

            <p>• What is AI?</p>

            <p>• What is this system?</p>

            <p>• How does this system work?</p>

            <p>• Which technology is used?</p>

            <p>• What is Flask?</p>

            <p>• What is SQLite?</p>

        </div>


        <div class="admin-link">

            <a href="{{ url_for('admin') }}">
                Admin Panel
            </a>

        </div>

    </div>


    <script src="{{ url_for('static',
                 filename='script.js') }}">
    </script>

</body>

</html>
