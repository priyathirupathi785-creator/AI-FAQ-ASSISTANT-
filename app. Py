from flask import Flask, render_template, request, redirect, url_for
import sqlite3
import re

app = Flask(__name__)

DATABASE = "database.db"


# -----------------------------------
# Database Connection
# -----------------------------------

def get_connection():

    connection = sqlite3.connect(DATABASE)

    connection.row_factory = sqlite3.Row

    return connection


# -----------------------------------
# Clean User Question
# -----------------------------------

def clean_text(text):

    text = text.lower()

    text = re.sub(r"[^a-zA-Z0-9\s]", "", text)

    return text


# -----------------------------------
# Find FAQ Answer
# -----------------------------------

def find_answer(user_question):

    user_question = clean_text(user_question)

    user_words = set(user_question.split())

    connection = get_connection()

    faqs = connection.execute(
        "SELECT * FROM faq"
    ).fetchall()

    connection.close()

    best_answer = None
    best_score = 0

    for faq in faqs:

        faq_question = clean_text(faq["question"])

        faq_words = set(faq_question.split())

        common_words = user_words.intersection(faq_words)

        score = len(common_words)

        if score > best_score:

            best_score = score

            best_answer = faq["answer"]

    if best_score > 0:

        return best_answer

    return (
        "Sorry, I could not find a suitable answer. "
        "Please try asking another question."
    )


# -----------------------------------
# Home Page
# -----------------------------------

@app.route("/", methods=["GET", "POST"])
def home():

    answer = ""
    question = ""

    if request.method == "POST":

        question = request.form.get("question", "").strip()

        if question:

            answer = find_answer(question)

        else:

            answer = "Please enter a question."

    return render_template(
        "index.html",
        answer=answer,
        question=question
    )


# -----------------------------------
# Admin Page
# -----------------------------------

@app.route("/admin", methods=["GET", "POST"])
def admin():

    message = ""

    connection = get_connection()

    if request.method == "POST":

        question = request.form.get("question", "").strip()

        answer = request.form.get("answer", "").strip()

        category = request.form.get("category", "").strip()

        if question and answer:

            connection.execute(
                """
                INSERT INTO faq
                (question, answer, category)
                VALUES (?, ?, ?)
                """,
                (question, answer, category)
            )

            connection.commit()

            message = "FAQ added successfully!"

    faqs = connection.execute(
        "SELECT * FROM faq ORDER BY id DESC"
    ).fetchall()

    connection.close()

    return render_template(
        "admin.html",
        faqs=faqs,
        message=message
    )


# -----------------------------------
# Delete FAQ
# -----------------------------------

@app.route("/delete/<int:faq_id>")
def delete_faq(faq_id):

    connection = get_connection()

    connection.execute(
        "DELETE FROM faq WHERE id = ?",
        (faq_id,)
    )

    connection.commit()

    connection.close()

    return redirect(url_for("admin"))


# -----------------------------------
# Run Application
# -----------------------------------

if __name__ == "__main__":

    app.run(debug=True)
