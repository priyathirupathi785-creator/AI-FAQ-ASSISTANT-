* {
    box-sizing: border-box;
}

body {

    margin: 0;

    font-family: Arial, sans-serif;

    background: #f2f5f9;

    color: #222;
}


/* Main Container */

.main-container {

    width: 650px;

    max-width: 90%;

    margin: 60px auto;

    background: white;

    padding: 30px;

    border-radius: 15px;

    box-shadow: 0 5px 20px rgba(0,0,0,0.1);

}


/* Header */

.header {

    text-align: center;

    margin-bottom: 30px;
}

.header h1 {

    margin-bottom: 10px;

}


/* Form */

form {

    display: flex;

    gap: 10px;

}

input[type="text"] {

    flex: 1;

    padding: 14px;

    border: 1px solid #ccc;

    border-radius: 8px;

    font-size: 15px;

}

button {

    padding: 14px 22px;

    border: none;

    border-radius: 8px;

    cursor: pointer;

    font-size: 15px;

    background: #333;

    color: white;

}

button:hover {

    opacity: 0.85;

}


/* Answer */

.answer-box {

    margin-top: 25px;

    padding: 20px;

    border-radius: 10px;

    background: #f5f5f5;

}

.answer-box h2 {

    margin-top: 0;

}


/* Examples */

.examples {

    margin-top: 30px;

    padding: 20px;

    border-radius: 10px;

    background: #fafafa;

}


/* Admin */

.admin-container {

    width: 1000px;

    max-width: 95%;

    margin: 40px auto;

    background: white;

    padding: 30px;

    border-radius: 15px;

}

.admin-container form {

    display: block;

}

.admin-container label {

    display: block;

    margin-top: 15px;

    margin-bottom: 5px;

    font-weight: bold;

}

textarea {

    width: 100%;

    min-height: 120px;

    padding: 12px;

    border: 1px solid #ccc;

    border-radius: 8px;

    resize: vertical;

}


/* Table */

table {

    width: 100%;

    margin-top: 25px;

    border-collapse: collapse;

}

th, td {

    border: 1px solid #ddd;

    padding: 10px;

    text-align: left;

}

th {

    background: #f2f2f2;

}


/* Success */

.success {

    padding: 12px;

    margin-bottom: 20px;

    background: #eeeeee;

    border-radius: 8px;

}


/* Links */

a {

    text-decoration: none;

}
